rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. HELPER FUNCTIONS
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "Sdsedu@gmail.com" || 
        request.auth.token.email == "exitexam@gmail.com" ||
        request.auth.token.email == "wondem@gmail.com"
      );
    }
    
    function isTeacher() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // 2. GLOBAL ADMIN ACCESS (Fixes your "Insufficient Permissions" error)
    match /{document=**} {
      allow read, write: if isAdmin() || isTeacher();
    }

    // 3. USER & PROFILE RULES
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Access to permissions subcollection
      match /permissions/{subjectId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
      
      // Access to payment history subcollection
      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 4. PAYMENTS & MANUAL RECEIPTS
    match /payments/{paymentId} {
      allow create, read, update: if request.auth != null;
    }

    match /manual_payments/{paymentId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // 5. EXISTING COURSE & CHAT LOGIC (Preserved)
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /{courseStudents}/{docId} {
      allow read, write: if request.auth != null;
    }

    match /examQuestions/{questionId} {
      allow read: if request.auth != null;
      // write is already allowed globally for admins and teachers, 
      // but explicitly denying write for others just in case
      allow write: if isAdmin() || isTeacher();
    }

    match /config/{document=**} {
      allow read: if request.auth != null;
    }
  }
}
